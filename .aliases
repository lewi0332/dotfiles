# Shortcuts
alias ch='history 0 | grep "git commit"'
alias hg='history 0 | grep'

# Detect which `ls` flavor is in use
if ls --color >/dev/null 2>&1; then # GNU `ls`
    colorflag="--color"
else # OS X `ls`
    colorflag="-G"
fi

# Always use color output for `ls`
alias ls="command ls ${colorflag}"
# For detailed colors on Mac, run 'man ls' and see the LSCOLORS section
export LSCOLORS='Dxexcxdxcxegedabagacad'
export LS_COLORS='no=00:fi=00:di=04;35:ln=01;36:pi=40;33:so=01;35:do=01;35:bd=40;33;01:cd=40;33;01:or=40;31;01:ex=01;32:*.tar=01;31:*.tgz=01;31:*.arj=01;31:*.taz=01;31:*.lzh=01;31:*.zip=01;31:*.z=01;31:*.Z=01;31:*.gz=01;31:*.bz2=01;31:*.deb=01;31:*.rpm=01;31:*.jar=01;31:*.jpg=01;35:*.jpeg=01;35:*.gif=01;35:*.bmp=01;35:*.pbm=01;35:*.pgm=01;35:*.ppm=01;35:*.tga=01;35:*.xbm=01;35:*.xpm=01;35:*.tif=01;35:*.tiff=01;35:*.png=01;35:*.mov=01;35:*.mpg=01;35:*.mpeg=01;35:*.avi=01;35:*.fli=01;35:*.gl=01;35:*.dl=01;35:*.xcf=01;35:*.xwd=01;35:*.ogg=01;35:*.mp3=01;35:*.wav=01;35:'

# Always enable colored `grep` output
# Note: `GREP_OPTIONS="--color=auto"` is deprecated, hence the alias usage.
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi

# Update/upgrade Homebrew and their installed packages
alias update_brew='brew update; brew upgrade; brew upgrade --cask; brew link --overwrite node; brew cleanup; $(brew --prefix)/bin/npm update --global; $(brew --prefix)/bin/pipx upgrade-all; $(brew --prefix)/bin/uv tool upgrade --all; $(brew --prefix)/bin/gh extension upgrade gh-copilot'

# Find Files and Directories
alias fd='find . -type d -iname'
alias ff='find . -type f -iname'

# list files 
alias ll='ls -alF'
# alias la='ls -A'
alias la="ls -lahF ${colorflag}"
alias l='ls -CF'
alias lg='lazygit'

alias python=python3
alias vim=nvim
alias -s html=open
alias -s png=open
alias -s jpg=open
alias -s jpeg=open
alias -s gif=open
alias -s pdf=open

csv_preview(){
    local max_rows=1000
    local file_size=$(wc -l < "$1" 2>/dev/null || echo "unknown")

    if [ "$file_size" -gt 10000 ]; then
        echo "Large CSV here ($file_size rows), limiting to $max_rows"
        visidata --max-rows "$max_rows" "$1"
    else
        visidata "$1"
    fi
}

alias -s csv=csv_preview

# Preview a dbt --inline SQL snippet (refs resolved) in visidata.
# Assumes cwd is a dbt project root with a ./dbt_env venv (see reverb-dbt).
dbtv(){
    local sql="$1"
    local limit="${2:-100}"
    # dbt show always appends its own LIMIT clause; strip any trailing
    # LIMIT in the user's SQL so we don't end up with two limits.
    sql=$(echo "$sql" | sed -E 's/[[:space:]]*;?[[:space:]]*[Ll][Ii][Mm][Ii][Tt][[:space:]]+[0-9]+[[:space:]]*;?[[:space:]]*$//')
    ./dbt_env/bin/dbt show --inline "$sql" --output json --quiet --limit "$limit" | jq '.show' | vd -f json
}

# Same, but opens in a tmux popup instead of taking over the current pane.
# Popup-first: the popup (or, outside tmux, the pane) opens immediately with
# a "running" status, then runs dbt inside it, so a slow query is visibly
# still working instead of leaving the caller staring at nothing. A hung
# query gets killed after DBTVP_TIMEOUT seconds, and a failed query shows
# dbt's stderr and waits for a keypress instead of silently closing.
dbtvp(){
    local sql="$1"
    local limit="${2:-100}"
    local timeout_secs="${DBTVP_TIMEOUT:-180}"
    local pwd_dir tmpfile errfile rawfile sqlfile scriptfile
    pwd_dir=$(pwd)
    tmpfile=$(mktemp /tmp/dbtvp_XXXXXX)
    errfile=$(mktemp /tmp/dbtvp_XXXXXX)
    rawfile=$(mktemp /tmp/dbtvp_XXXXXX)
    sqlfile=$(mktemp /tmp/dbtvp_XXXXXX)
    scriptfile=$(mktemp /tmp/dbtvp_XXXXXX)

    # dbt show always appends its own LIMIT clause; strip any trailing
    # LIMIT in the user's SQL so we don't end up with two limits.
    sql=$(echo "$sql" | sed -E 's/[[:space:]]*;?[[:space:]]*[Ll][Ii][Mm][Ii][Tt][[:space:]]+[0-9]+[[:space:]]*;?[[:space:]]*$//')
    printf '%s' "$sql" > "$sqlfile"

    # No `timeout`/`gtimeout` binary on stock macOS, so the deadline is
    # implemented by hand: run dbt in the background, race it against a
    # sleep, and SIGTERM it if the sleep wins.
    cat > "$scriptfile" <<SCRIPT
#!/usr/bin/env bash
cd "$pwd_dir" || exit 1
sql=\$(cat "$sqlfile")
echo "Running dbt query (timeout ${timeout_secs}s)..."
echo

./dbt_env/bin/dbt show --inline "\$sql" --output json --quiet --limit "$limit" > "$rawfile" 2> "$errfile" &
dbt_pid=\$!

( sleep "$timeout_secs"; kill -TERM "\$dbt_pid" 2>/dev/null ) &
watcher_pid=\$!

wait "\$dbt_pid"
dbt_status=\$?
kill "\$watcher_pid" 2>/dev/null
wait "\$watcher_pid" 2>/dev/null

if [ "\$dbt_status" -eq 0 ] && jq '.show' "$rawfile" > "$tmpfile" 2>>"$errfile"; then
    vd -f json "$tmpfile"
else
    echo
    if [ "\$dbt_status" -ge 128 ]; then
        echo "dbt show timed out after ${timeout_secs}s (killed)"
    else
        echo "dbt show failed:"
    fi
    echo
    cat "$errfile"
    echo
    echo "Press any key to close..."
    read -n 1 -s
fi
rm -f "$tmpfile" "$errfile" "$rawfile" "$sqlfile" "$scriptfile"
SCRIPT
    chmod +x "$scriptfile"

    if [ -n "$TMUX" ]; then
        tmux popup -d "$pwd_dir" -w 80% -h 70% -E "$scriptfile"
    else
        bash "$scriptfile"
    fi
}

